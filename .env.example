# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Long random string (at least 32 characters). Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Optional, defaults to progressive-overload
MONGODB_DB=
# Optional: read-only gym days feed (GET /api/gym-days?key=...). Off unless both are set.
GYM_FEED_KEY=
GYM_FEED_USERNAME=
# Optional, defaults to Europe/London
GYM_FEED_TIMEZONE=
